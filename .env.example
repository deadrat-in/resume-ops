#providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_BASE_URL=

#models
# Specify DEFAULT_MODEL to configure all sections at once:
DEFAULT_MODEL=deepseek/deepseek-v4-pro
# Or override specific sections as needed:
# STRATEGY_MODEL=deepseek/deepseek-v4-pro
# WORK_MODEL=deepseek/deepseek-v4-pro
# EDUCATION_MODEL=qwen/minimax/minimax-m2.7
# SKILLS_MODEL=qwen/minimax/minimax-m2.7
# PROJECTS_MODEL=qwen/qwen3.6-plus
# CERTIFICATES_MODEL=qwen/qwen3.6-plus
# OPTIONAL_SECTIONS_MODEL=qwen/qwen3.6-plus
# BASICS_MODEL=qwen/qwen3.6-plus

#theme
DEFAULT_THEME=jsonresume-theme-folio
ALLOWED_THEMES=["jsonresume-theme-folio", "jsonresume-theme-folio-concise", "jsonresume-theme-stackoverflow"]

#style
# Optional: Set a writing style, tone, or regional language guideline
# Examples: "concise", "verbose", "british english", "australian english", "witty and cheerful"
TAILORING_STYLE=

#flows
MAX_CONCURRENT_JOBS=2
CALLBACK_TIMEOUT_SECONDS=5

#data
# DATA_DIR sets the directory for persistent application data (database, uploads, etc.)
#
#   /data    — Use when running inside a Podman/container environment, as it is
#              the standard volume mount point (see compose.yaml).
#
#   ./data   — Use for local development (no container) to keep data relative to
#              the project root.
#
DATA_DIR=/data
MASTER_RESUME_PATH=/data/master-resume.json
DATABASE_URL=
LOG_LEVEL=INFO

# LLM Throttling & Rate Limiting
# Configures client-side rate limiting and concurrency limits.
# Set LLM_RATE_LIMIT_REQUESTS to an integer to enforce a maximum number of requests
# in any LLM_RATE_LIMIT_PERIOD_SECONDS window. Set to empty/unset to disable.
LLM_RATE_LIMIT_REQUESTS=20
LLM_RATE_LIMIT_PERIOD_SECONDS=60
# Set LLM_MAX_CONCURRENCY to limit the maximum number of parallel requests sent to the LLM.
LLM_MAX_CONCURRENCY=2
# Set LLM_MAX_RETRIES to configure how many times structured LLM generation retries on transient errors (default: 10).
# For free OpenRouter models that fail often, set this higher (e.g. 20-30).
# For synchronous web requests, set to 3 or 4 to fail fast instead of hanging.
LLM_MAX_RETRIES=10
# Exponential back-off window between retries (seconds).
# For free-tier LLMs with rate limits / long queues, increase LLM_RETRY_MAX_WAIT_SECONDS (e.g. 120).
LLM_RETRY_MIN_WAIT_SECONDS=3
LLM_RETRY_MAX_WAIT_SECONDS=60
# Multiplier for the exponential curve.  wait = multiplier * 2^attempt, capped at MAX.
LLM_RETRY_MULTIPLIER=3
# Enable client-side caching for LLM requests to avoid repeating calls (true/false)
LLM_CACHE=false

# Tracing & Evaluation Configuration
# Set ENABLE_TRACING=true to enable live execution tracing via Opik / LiteLLM callbacks
ENABLE_TRACING=false
# OPIK_API_KEY=your_opik_api_key_here
OPIK_PROJECT_NAME=resume-ops
# OPIK_WORKSPACE=your_opik_workspace_here
# Optional model to use as evaluator/judge for DeepEval / Promptfoo (defaults to DEFAULT_MODEL)
# EVAL_MODEL=openai/gpt-4o-mini
